# Anthropic — used for final/hosted version. Leave blank to use Ollama locally.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-6

# Ollama — local LLM used during dev/demo.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:latest
OLLAMA_TIMEOUT_S=5

DATABASE_PATH=./db/drivelegal.db
CHROMA_PATH=./chroma
DEFAULT_COUNTRY=IN
LOG_LEVEL=INFO
